      value: 3
      objectReference: {fileID: 0}
    - target: {fileID: 3820644863327861603, guid: 1115b42ae01f4fd42b20896df7abdc4e, type: 3}
      propertyPath: 'sentences.Array.data[0]'
      value: "\u0110\xE2y l\xE0 ph\xF2ng th\u1EF1c h\xE0nh, n\u01A1i em s\u1EBD th\u1EF1c
        hi\u1EC7n b\xE0i thi c\u1EE7a m\xECnh."
      objectReference: {fileID: 0}
    - target: {fileID: 3820644863327861603, guid: 1115b42ae01f4fd42b20896df7abdc4e, type: 3}
      propertyPath: 'sentences.Array.data[1]'
      value: "H\xE3y s\u1EED d\u1EE5ng nh\u1EEFng k\u1EF9 n\u0103ng v\xE0 s\u1EF1
        kh\xE9o l\xE9o c\u1EE7a em \u0111\u1EC3 ho\xE0n th\xE0nh nhi\u1EC7m v\u1EE5."
      objectReference: {fileID: 0}
    - target: {fileID: 3820644863327861603, guid: 1115b42ae01f4fd42b20896df7abdc4e, type: 3}
      propertyPath: 'sentences.Array.data[2]'
      value: "Ch\xFAc em may m\u1EAFn!"
      objectReference: {fileID: 0}
    - target: {fileID: 3820644863327861603, guid: 1115b42ae01f4fd42b20896df7abdc4e, type: 3}
      propertyPath: sentencesPhase2.Array.size
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 3820644863327861603, guid: 1115b42ae01f4fd42b20896df7abdc4e, type: 3}
      propertyPath: 'sentencesPhase2.Array.data[0]'
      value: "Ch\xFAc m\u1EEBng em! Em \u0111\xE3 ho\xE0n th\xE0nh b\xE0i thi th\u1EF1c
        h\xE0nh m\u1ED9t c\xE1ch xu\u1EA5t s\u1EAFc."
      objectReference: {fileID: 0}
    - target: {fileID: 3820644863327861603, guid: 1115b42ae01f4fd42b20896df7abdc4e, type: 3}
      propertyPath: 'sentencesPhase2.Array.data[1]'
      value: "Nh\u1EEFng k\u1EF9 n\u0103ng m\xE0 em \u0111\xE3 h\u1ECDc \u0111\u01B0\u1EE3c
        \u0111\xE3 gi\xFAp em v\u01B0\u1EE3t qua th\u1EED th\xE1ch n\xE0y.\nCh\xFAc
        m\u1EEBng em"
      objectReference: {fileID: 0}
    - target: {fileID: 3820644863327861603, guid: 1115b42ae01f4fd42b20896df7abdc4e, type: 3}
      propertyPath: 'sentencesPhase2.Array.data[2]'
      value: "Gi\u1EDD em \u0111\xE3 \u0111\u1EE7 \u0111i\u1EC1u ki\u1EC7n \u0111\u1EC3
        c\xF3 th\u1EC3 b\u1EA3o v\u1EC7 \u0111\u1ED3 \xE1n"
      objectReference: {fileID: 0}
