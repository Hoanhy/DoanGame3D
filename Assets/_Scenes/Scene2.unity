--- !u!114 &1924518040
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1924518039}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6c0cbf2ad046dad4781ee83e4a46b4dd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::UnityTutorial.Quiz.QuizManager
  questions:
  - questionText: "Tr\u01B0\u1EDDng Cao \u0111\u1EB3ng C\xF4ng ngh\u1EC7 B\xE1ch
      khoa H\xE0 N\u1ED9i n\u1EB1m \u1EDF \u0111\xE2u?"
    answers:
    - "C\u1EA7u Gi\u1EA5y, H\xE0 N\u1ED9i"
    - "Nam T\u1EEB Li\xEAm, H\xE0 N\u1ED9i"
    - "Ho\xE0n Ki\u1EBFm, H\xE0 N\u1ED9i"
    - "H\xE0 \u0110\xF4ng, H\xE0 N\u1ED9i"
    correctAnswerIndex: 1
  - questionText: "Th\u1EDDi gian \u0111\xE0o t\u1EA1o h\u1EC7 cao \u0111\u1EB3ng
      t\u1EA1i tr\u01B0\u1EDDng th\u01B0\u1EDDng k\xE9o d\xE0i bao l\xE2u?"
    answers:
    - "4 n\u0103m"
    - "5 n\u0103m"
    - "2 \u2013 3 n\u0103m"
    - "1 n\u0103m"
    correctAnswerIndex: 2
  - questionText: "Ph\u01B0\u01A1ng th\u1EE9c tuy\u1EC3n sinh ph\u1ED5 bi\u1EBFn
      c\u1EE7a tr\u01B0\u1EDDng l\xE0 g\xEC?"
    answers:
    - "X\xE9t h\u1ECDc b\u1EA1 THPT"
    - "Ph\u1ECFng v\u1EA5n tr\u1EF1c ti\u1EBFp"
    - "Thi tuy\u1EC3n ri\xEAng"
    - "Thi n\u0103ng khi\u1EBFu"
    correctAnswerIndex: 0
  - questionText: "Ng\xE0nh n\xE0o sau \u0111\xE2y c\xF3 \u0111\xE0o t\u1EA1o t\u1EA1i
      Tr\u01B0\u1EDDng Cao \u0111\u1EB3ng C\xF4ng ngh\u1EC7 B\xE1ch khoa H\xE0 N\u1ED9i?"
    answers:
    - "Qu\u1EA3n tr\u1ECB kinh doanh"
    - "C\xF4ng ngh\u1EC7 \xF4 t\xF4"
    - "C\xF4ng ngh\u1EC7 th\xF4ng tin"
    - "T\u1EA5t c\u1EA3 c\xE1c \u0111\xE1p \xE1n tr\xEAn"
    correctAnswerIndex: 3
  - questionText: "Sau khi t\u1ED1t nghi\u1EC7p cao \u0111\u1EB3ng t\u1EA1i tr\u01B0\u1EDDng,
      sinh vi\xEAn c\xF3 th\u1EC3 l\xE0m g\xEC ti\u1EBFp theo?"
    answers:
    - "\u0110i l\xE0m ngay"
    - "H\u1ECDc th\xEAm ch\u1EE9ng ch\u1EC9 ngh\u1EC1"
    - "Li\xEAn th\xF4ng l\xEAn \u0111\u1EA1i h\u1ECDc"
    - "T\u1EA5t c\u1EA3 c\xE1c \u0111\xE1p \xE1n tr\xEAn"
    correctAnswerIndex: 3
  - questionText: "Ph\u01B0\u01A1ng ph\xE1p \u0111\xE0o t\u1EA1o c\u1EE7a tr\u01B0\u1EDDng
      thi\xEAn v\u1EC1 \u0111i\u1EC1u g\xEC?"
    answers:
    - "Th\u1EF1c h\xE0nh ngh\u1EC1 nghi\u1EC7p"
    - "Nghi\xEAn c\u1EE9u khoa h\u1ECDc"
    - "H\u1ECDc tr\u1EF1c tuy\u1EBFn ho\xE0n to\xE0n"
    - "L\xFD thuy\u1EBFt chuy\xEAn s\xE2u"
    correctAnswerIndex: 0
  - questionText: "\u0110\u1ED1i t\u01B0\u1EE3ng tuy\u1EC3n sinh ch\xEDnh c\u1EE7a
      tr\u01B0\u1EDDng l\xE0 ai?"
    answers:
    - "Sinh vi\xEAn \u0111\u1EA1i h\u1ECDc"
    - "Ng\u01B0\u1EDDi n\u01B0\u1EDBc ngo\xE0i"
    - "H\u1ECDc sinh t\u1ED1t nghi\u1EC7p THPT"
    - "H\u1ECDc sinh t\u1ED1t nghi\u1EC7p THCS"
    correctAnswerIndex: 2
  - questionText: "Sinh vi\xEAn t\u1EA1i Tr\u01B0\u1EDDng Cao \u0111\u1EB3ng C\xF4ng
      ngh\u1EC7 B\xE1ch khoa H\xE0 N\u1ED9i c\xF3 th\u1EC3 tham gia g\xEC ngo\xE0i
      gi\u1EDD h\u1ECDc?"
    answers:
    - "Ho\u1EA1t \u0111\u1ED9ng t\xECnh nguy\u1EC7n"
    - "Ho\u1EA1t \u0111\u1ED9ng ngo\u1EA1i kh\xF3a"
    - "C\xE2u l\u1EA1c b\u1ED9 sinh vi\xEAn"
    - "T\u1EA5t c\u1EA3 c\xE1c \u0111\xE1p \xE1n tr\xEAn"
    correctAnswerIndex: 3
  - questionText: "M\u1EE5c ti\xEAu \u0111\xE0o t\u1EA1o ch\xEDnh c\u1EE7a tr\u01B0\u1EDDng
      l\xE0 g\xEC?"
    answers:
    - "\u0110\xE0o t\u1EA1o nghi\xEAn c\u1EE9u sinh"
    - "\u0110\xE0o t\u1EA1o k\u1EF9 n\u0103ng ngh\u1EC1 nghi\u1EC7p th\u1EF1c t\u1EBF"
    - "\u0110\xE0o t\u1EA1o gi\u1EA3ng vi\xEAn \u0111\u1EA1i h\u1ECDc"
    - "\u0110\xE0o t\u1EA1o l\xFD thuy\u1EBFt chuy\xEAn s\xE2u"
    correctAnswerIndex: 1
  - questionText: "T\xEAn vi\u1EBFt t\u1EAFt th\u01B0\u1EDDng \u0111\u01B0\u1EE3c
      d\xF9ng cho tr\u01B0\u1EDDng l\xE0 g\xEC?"
    answers:
    - BKHN
    - HNU
    - HPC
    - HUST
    correctAnswerIndex: 2
