--- !u!114 &3820644863327861603
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2702734374562629029}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fba675283881e75459e403c3507c71f6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TeacherNPC
  interactUI: {fileID: 0}
  dialoguePanel: {fileID: 0}
  nameText: {fileID: 0}
  dialogueText: {fileID: 0}
  npcName: "Gi\xE1m Th\u1ECB"
  dialogueCamera: {fileID: 0}
  sentences:
  - "Ch\xE0o m\u1EEBng em \u0111\u1EBFn v\u1EDBi HPC!\nCh\xFAc m\u1EEBng em \u0111\xE3
    v\u01B0\u1EE3t qua th\u1EED th\xE1ch tr\u01B0\u1EDBc \u0111\xF3. T\u1ED1t l\u1EAFm!"
  - "K\u1EF3 thi l\xFD thuy\u1EBFt n\xE0y s\u1EBD ki\u1EC3m tra nh\u1EEFng g\xEC
    em bi\u1EBFt \u0111\u01B0\u1EE3c.\nH\xE3y \u0111\u1ECDc k\u1EF9 t\u1EEBng c\xE2u
    h\u1ECFi tr\u01B0\u1EDBc khi tr\u1EA3 l\u1EDDi."
  - "Gi\u1EDD \u0111\xE2y em \u0111\xE3 s\u1EB5n s\xE0ng b\u01B0\u1EDBc v\xE0o k\u1EF3
    thi ch\xEDnh th\u1EE9c.\nH\xE3y b\xECnh t\u0129nh, t\u1EADp trung v\xE0 l\xE0m
    h\u1EBFt kh\u1EA3 n\u0103ng c\u1EE7a m\xECnh nh\xE9."
  - "Gi\u1EDD em h\xE3y v\xE0o ch\u1ED7 ng\u1ED3i b\u1EA5t k\u1EF3 \u0111\u1EC3 ta
    c\xF3 th\u1EC3 b\u1EAFt \u0111\u1EA7u v\xE0o k\u1EF3 thi"
  - "Ch\xFAc em may m\u1EAFn!"
  quizManager: {fileID: 0}
  isCombatCleared: 0
  sentencesPhase2:
  - "Ch\xFAc m\u1EEBng em! Em \u0111\xE3 v\u01B0\u1EE3t qua k\u1EF3 thi l\xFD thuy\u1EBFt
    m\u1ED9t c\xE1ch xu\u1EA5t s\u1EAFc."
  - "Ti\u1EBFp theo \u0111\xE2y ch\xFAng ta s\u1EBD sang ph\xF2ng thi th\u1EF1c h\xE0nh "
  onDialogueEndPhase2:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 0}
        m_TargetAssemblyTypeName: Teleporter, Assembly-CSharp
        m_MethodName: TeleportPlayer
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  onDialogueEnd:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 0}
        m_TargetAssemblyTypeName: QuizRoomManager, Assembly-CSharp
        m_MethodName: UnlockAllDesks
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
